generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// The ledger — the single source of truth. Holdings are always derived from these rows.
model Transaction {
  id             Int      @id @default(autoincrement())
  owner          String   @default("Investor A") // which investor this trade belongs to (shared Finqalab account)
  broker         String   @default("finqalab") // profile slug the row was imported under
  security       String
  /// Soft reference to Asset.id (e.g. "psx:LUCK", "crypto:BTC"). Deliberately NOT
  /// a foreign key: the ledger is user-owned and must survive the market-data
  /// catalogue being wiped and reseeded. Null on rows imported before markets
  /// existed — `resolveAssetId` falls back to psx:{security}.
  assetId        String?
  tradeNo        String // broker's trade number — unique per broker, not globally
  tradeDate      String // yyyy-mm-dd (sorts chronologically as text)
  settlementDate String
  side           String // BUY | SELL
  rate           Float // execution price per share
  /// Float, not Int: a share count is whole but a crypto position is not, and
  /// 0.05 BTC has to be representable in the same ledger as 500 LUCK.
  qty            Float
  grossAmount    Float // rate * qty
  brokerage      Float // total broker commission for the trade
  cvt            Float
  netAmount      Float // BUY: gross+fees, SELL: gross-fees
  sourceFile     String?
  importedAt     DateTime @default(now())

  /// Dedup key: re-importing the same/overlapping report never double-counts.
  /// Scoped by broker so two brokers numbering from 1 can't collide.
  @@unique([broker, tradeNo])
  @@index([security])
  @@index([assetId])
  @@index([tradeDate])
  @@index([owner])
}

/// History of PDF imports (for display / audit).
model ImportBatch {
  id                Int      @id @default(autoincrement())
  owner             String   @default("Investor A")
  broker            String   @default("finqalab") // profile slug used to read the file
  parser            String   @default("reused") // reused | learned — did this upload cost an LLM call?
  filename          String
  uploadedAt        DateTime @default(now())
  totalParsed       Int
  tradesAdded       Int
  duplicatesSkipped Int
}

/// A broker statement parser, stored as a declarative spec (see src/lib/broker-spec.ts).
///
/// Built-in profiles are seeded from code; the rest are written once by an LLM the
/// first time an unrecognised statement is uploaded, then replayed for free.
model BrokerProfile {
  id           Int                 @id @default(autoincrement())
  slug         String              @unique
  broker       String // display name, e.g. "Finqalab"
  spec         String // BrokerParseSpec as JSON
  source       String // builtin | llm
  model        String? // which model authored it, when source = llm
  notes        String? // the author's own note on how the layout reads
  createdAt    DateTime            @default(now())
  lastUsedAt   DateTime?
  useCount     Int                 @default(0)
  fingerprints BrokerFingerprint[]
}

/// Layout fingerprints known to belong to a profile — the fast path on re-upload.
/// One profile accumulates several as a broker tweaks its report header.
model BrokerFingerprint {
  hash      String        @id
  profileId Int
  profile   BrokerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([profileId])
}

/**
 * ---------------------------------------------------------------------------
 * Market data — external, refetchable, and deliberately kept apart from the
 * ledger above. Nothing here is user-owned: dropping every row costs one
 * refresh. The ledger never stores a price; it joins to these at read time.
 * -------------------------------------------------------------------------
 */

/// Anything with a price, in any market. One row per instrument we track.
///
/// `id` is `{market}:{symbol}` — readable in a URL and unique across markets, so
/// PSX's LUCK and a hypothetical US LUCK can coexist. `source`/`sourceSymbol` are
/// how a provider names it (Yahoo calls gold "GC=F"; CoinGecko calls bitcoin
/// "bitcoin"), which keeps provider vocabulary out of the rest of the app.
model Asset {
  id           String  @id
  market       String // see MARKETS in src/lib/markets.ts
  symbol       String // display ticker: AAPL, BTC, USD/PKR
  name         String
  kind         String // stock | etf | reit | index | crypto | commodity | fx_pair | bond_yield
  /// Currency the price is quoted in. A bond yield and an index quote "points".
  currency     String
  source       String // provider id: yahoo | coingecko | frankfurter | psx
  sourceSymbol String
  /// Lower sorts first on the market pages. Ties break alphabetically.
  rank         Int     @default(100)
  /// Part of the seeded market overview (vs. pulled in only because it's held).
  benchmark    Boolean @default(false)
  active       Boolean @default(true)

  quote Quote?
  bars  PriceBar[]
  news  NewsMatch[]

  @@unique([market, symbol])
  @@index([market])
  @@index([source])
}

/// The latest snapshot for an asset — one row per asset, overwritten on refresh.
/// Intraday truth. Historical truth lives in PriceBar.
model Quote {
  assetId       String    @id
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  price         Float
  previousClose Float?
  change        Float?
  changePct     Float?
  dayHigh       Float?
  dayLow        Float?
  volume        Float?
  /// When the venue last traded it (not when we fetched it).
  marketTime    DateTime?
  source        String
  fetchedAt     DateTime  @default(now())

  @@index([fetchedAt])
}

/// One daily close per asset. The basis for every weekly/monthly/YTD number —
/// without these, "what moved this week" is unanswerable.
model PriceBar {
  assetId String
  /// yyyy-mm-dd, matching Transaction.tradeDate — sorts chronologically as text.
  date    String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  open    Float?
  high    Float?
  low     Float?
  close   Float
  volume  Float?
  source  String

  @@id([assetId, date])
  @@index([date])
}

/// Outcome of one market-data refresh, so a silently failing provider is visible
/// rather than showing up as prices that quietly stop moving.
model RefreshRun {
  id          Int       @id @default(autoincrement())
  source      String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  assetsOk    Int       @default(0)
  assetsFail  Int       @default(0)
  barsWritten Int       @default(0)
  error       String?

  @@index([source, startedAt])
}

/**
 * ---------------------------------------------------------------------------
 * News — external and disposable, like market data above. Dropping every row
 * costs one ingest. Nothing here is user-owned and nothing here is a price.
 * -------------------------------------------------------------------------
 */

/// One headline, from any feed, after the provider has been normalised away.
///
/// `id` is a hash of the canonical URL rather than a provider's own guid: the
/// same story arrives from Yahoo and from Google News under two different guids,
/// and deduping on the URL is what stops it being counted twice.
model NewsArticle {
  id          String   @id
  title       String
  /// Canonical — tracking parameters stripped. The identity of the article.
  url         String   @unique
  /// Who published it ("Reuters"). Distinct from `provider`, which is who fetched it.
  source      String
  provider    String // yahoo | google | cnbc
  summary     String?
  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  /// The market whose feed produced it. Null for a general story — not a gap: a
  /// Fed decision belongs to every market, and pinning it to one would be a guess.
  market      String?

  matches NewsMatch[]

  @@index([publishedAt])
  @@index([market, publishedAt])
}

/// An article's link to an asset, with how confident that link is and why.
///
/// A real foreign key, unlike `Transaction.assetId`: both sides are disposable
/// market data, so cascading a match away with its asset is correct. The article
/// itself survives — re-matching is free, re-fetching is not.
model NewsMatch {
  articleId String
  assetId   String
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  asset     Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// 0–1. See BASE in src/lib/news/relevance.ts.
  score     Float
  /// feed | symbol | name | alias — provenance beats text, and the difference is
  /// recorded rather than flattened, so an insight can say what it actually read.
  via       String

  @@id([articleId, assetId])
  @@index([assetId])
  @@index([score])
}

/// Outcome of one news ingest, so a feed that quietly goes dark is visible.
/// Without this, "no news today" and "the feed 404s now" look identical.
model NewsRun {
  id           Int       @id @default(autoincrement())
  /// What was asked for: "all", or a market id.
  scope        String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  queriesRun   Int       @default(0)
  queriesFail  Int       @default(0)
  articlesSeen Int       @default(0)
  articlesNew  Int       @default(0)
  matchesMade  Int       @default(0)
  error        String?

  @@index([scope, startedAt])
}
