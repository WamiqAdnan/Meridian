generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// The ledger — the single source of truth. Holdings are always derived from these rows.
model Transaction {
  id             Int      @id @default(autoincrement())
  security       String
  tradeNo        String   @unique // dedup key: re-importing the same/overlapping report never double-counts
  tradeDate      String // yyyy-mm-dd (sorts chronologically as text)
  settlementDate String
  side           String // BUY | SELL
  rate           Float // execution price per share
  qty            Int
  grossAmount    Float // rate * qty
  brokerage      Float // total broker commission for the trade
  cvt            Float
  netAmount      Float // BUY: gross+fees, SELL: gross-fees
  sourceFile     String?
  importedAt     DateTime @default(now())

  @@index([security])
  @@index([tradeDate])
}

/// Cached live prices from the PSX market-watch feed.
model PriceCache {
  symbol    String   @id
  lastPrice Float
  change    Float?
  changePct Float?
  fetchedAt DateTime @default(now())
}

/// History of PDF imports (for display / audit).
model ImportBatch {
  id                Int      @id @default(autoincrement())
  filename          String
  uploadedAt        DateTime @default(now())
  totalParsed       Int
  tradesAdded       Int
  duplicatesSkipped Int
}
